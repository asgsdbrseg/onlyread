<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 决策 #1：所有文件访问权限，绝对路径直读，仅侧载分发 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- M3：选区菜单应用可见性（ColorDict 词典接口 / 通用文字接口） -->
    <queries>
        <intent>
            <action android:name="colordict.intent.action.SEARCH" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="colordict.intent.action.SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OnlyRead">

        <!-- 0.4.22：不再拦截配置变化，交给系统重建（这两个页面无自绘分页状态，
             onSaveInstanceState 已覆盖所需状态）。 -->
        <!-- singleTask：书架在应用 task 中全局唯一。任意来源（桌面图标 / 外部「打开方式」）
             启动 MainActivity 都复用同一实例并回调 onNewIntent，系统自动清掉其上 Activity，
             无需在 onCreate 里自行转发 intent 或 finish，避免栈里叠出两个书架、后台导入
             时新实例落在调用者 task 导致的误退出。 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 外部文件夹点 EPUB → 「打开方式 / 用…打开」里出现 onlyread。
                 ① 标准 EPUB MIME：系统「文件」应用、下载管理器、浏览器 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>

            <!-- ② 扩展名兜底：文件管理器把 .epub 报成其它/空 MIME 时，靠 .epub 路径匹配。
                 多组 pathPattern 是为绕开 Android pathPattern 对多段点号路径的匹配缺陷。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\.epub" />
                <data android:pathPattern=".*\..*\.epub" />
                <data android:pathPattern=".*\..*\..*\.epub" />
                <data android:pathPattern=".*\..*\..*\..*\.epub" />
                <data android:pathPattern=".*\.EPUB" />
                <data android:pathPattern=".*\..*\.EPUB" />
                <data android:pathPattern=".*\..*\..*\.EPUB" />
                <data android:pathPattern=".*\..*\..*\..*\.EPUB" />
            </intent-filter>

            <!-- ③ content:// 且被报成通用二进制：SAF Uri 的 path 常不含 .epub，②的
                 pathPattern 匹配不到，单独兜底；运行时按 MIME / 文件名二次校验。 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <activity
            android:name=".browser.FileBrowserActivity"
            android:exported="false" />

        <!-- BookActivity 例外：分页几何、锚点、已加载的 WebView 需跨旋屏保留，
             且必须拦截 keyboardHidden，否则输入法弹出会触发 Activity 重建、
             令搜索窗口与选区浮层消失。窗口固定 adjustNothing，浮层位置由代码写死。 -->
        <activity
            android:name=".reader.BookActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:windowSoftInputMode="adjustNothing" />

    </application>
</manifest>
